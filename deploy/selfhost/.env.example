# Settings for deploy/selfhost/docker-compose.yml. Copy to ".env" (same folder) and edit:
#   cp .env.example .env
# ".env" is git-ignored. It holds the admin password hash: keep it private (chmod 600 .env).
#
# Values are used as they are: no quotes needed. A value containing "$" must be written in single quotes ('...'),
# otherwise compose treats "$..." as a variable reference. (hash-password output is base64 and has no "$".)

# --- Required -----------------------------------------------------------------------------------

# Public host name of the server. DNS must point at this machine and ports 80 and 443 must be reachable
# from the internet (Let's Encrypt validation). For a local test use "localhost" together with TLS_MODE=internal.
DOMAIN=cxml.example.com

# Contact e-mail for the certificate authority (expiry notices). Required, even with TLS_MODE=internal.
# Use a real address on a real domain: Let's Encrypt rejects example.com addresses.
ACME_EMAIL=you@example.com

# Hash of the admin password. Create it with the image you run:
#   docker run --rm -it ghcr.io/mthpbs/cxml-dev-server:latest hash-password
# (-it is required: it prompts for the password without echo; or pass it as an argument - mind your shell history). Paste the output here.
ADMIN_PASSWORD_HASH=

# --- Optional -----------------------------------------------------------------------------------

# Image to run. Pin a version tag for predictable upgrades/rollbacks instead of "latest".
# Build it locally instead with: docker compose up -d --build
#IMAGE=ghcr.io/mthpbs/cxml-dev-server:latest

# Admin user name.
#ADMIN_USERNAME=admin

# Externally visible URL, used for StartPage and Profile URLs. Default: https://<DOMAIN>.
# Set it when something else (another proxy, a different port) is in front of Caddy.
#CXML_PUBLIC_BASE_URL=https://cxml.example.com

# true: process documents from unknown senders with a warning. false (default): answer 401.
#CXML_ALLOW_UNKNOWN_PARTNERS=false

# true: create the demo trading partners with well-known secrets (devsecret, abracadabra) in a NEW database.
# false (default here): start empty - create real partners in the admin UI. Only affects an empty database.
#CXML_SEED_DEMO_PARTNERS=false

# Certificate source:
#   acme      (default) public certificate from Let's Encrypt for DOMAIN.
#   internal  certificate from Caddy's own CA - for LAN/test use (DOMAIN=localhost or an internal name). Clients must
#             trust Caddy's root CA (found in the caddy_data volume: pki/authorities/local/root.crt), or use -k with curl.
#TLS_MODE=acme

# Backups (SQLite online backup into deploy/selfhost/backups): interval and how long files are kept.
#BACKUP_INTERVAL_HOURS=24
#BACKUP_RETENTION_DAYS=14

# Time zone for container logs, e.g. Europe/Berlin. Backup file names always use UTC.
#TZ=UTC

# Host ports of Caddy. Change only for testing; public certificates need 80 and 443.
#HTTP_PORT=80
#HTTPS_PORT=443
