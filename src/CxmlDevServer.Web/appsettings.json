{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // SQLite database file. A relative path is placed below the content root; its folder is created on startup.
    "Default": "Data Source=data/cxml-dev.db"
  },
  "Cxml": {
    // Externally visible base URL (for example behind a reverse proxy or tunnel). Empty: derived from each request.
    // It is used for StartPage URLs, ProfileResponse URLs and the BrowserFormPost URL in the sender templates.
    "PublicBaseUrl": "",
    // How long a PunchOut session (and its StartPage URL) stays usable, in minutes.
    "PunchOutSessionMinutes": 60,
    // false: documents from senders that match no trading partner are answered with 401. true: they are processed with a warning.
    "AllowUnknownPartners": false,
    // The UserAgent placed in the Sender of documents created by this server.
    "UserAgent": "cXML Dev Server 1.0",
    // How strictly unknown partners are validated: Strict, Lenient or Off.
    "DefaultValidationMode": "Lenient",
    // Supplier credential used in outbound headers when no supplier identity is stored.
    "SupplierDomain": "DUNS",
    "SupplierIdentity": "123456789",
    // Currency for empty carts and templates.
    "DefaultCurrency": "USD",
    // true: apply migrations and seed demo data (partners, catalog, scenario) at startup.
    "InitializeDatabaseOnStartup": true
  }
}
