{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // SQLite database file. A relative path is placed below the content root; its folder is created on startup.
    "Default": "Data Source=data/cxml-dev.db"
  },
  "Cxml": {
    // Externally visible base URL (for example behind a reverse proxy or tunnel). Empty: derived from each request.
    // It is used for StartPage URLs, ProfileResponse URLs and the BrowserFormPost URL in the sender templates.
    "PublicBaseUrl": "",
    // How long a PunchOut session (and its StartPage URL) stays usable, in minutes.
    "PunchOutSessionMinutes": 60,
    // false: documents from senders that match no trading partner are answered with 401. true: they are processed with a warning.
    "AllowUnknownPartners": false,
    // The UserAgent placed in the Sender of documents created by this server.
    "UserAgent": "cXML Dev Server 1.0",
    // How strictly unknown partners are validated: Strict, Lenient or Off.
    "DefaultValidationMode": "Lenient",
    // Supplier credential used in outbound headers when no supplier identity is stored.
    "SupplierDomain": "DUNS",
    "SupplierIdentity": "123456789",
    // Currency for empty carts and templates.
    "DefaultCurrency": "USD",
    // true: apply migrations and seed demo data (partners, catalog, scenario) at startup.
    "InitializeDatabaseOnStartup": true,
    // true: an empty database also gets the demo trading partners (well-known secrets such as "devsecret") and a sample
    // scenario. false (recommended for shared environments): only supplier identities and the catalog are seeded.
    "SeedDemoPartners": true
  },
  "Admin": {
    // false: the admin UI is open (local runs). true: it requires a login; the cXML endpoint (/cxml), the PunchOut
    // shop (/punchout/*), the test buyer (/test-buyer/*) and /health stay open to buyers.
    // When true, set PasswordHash (or Password) - the application does not start without one.
    "Enabled": false,
    "Username": "admin",
    // Preferred: an ASP.NET Core Identity password hash. Create one with
    //   dotnet run --project src/CxmlDevServer.Web --no-launch-profile -- hash-password
    // or `docker run -it --rm <image> hash-password`. Keep it out of this file: use the environment variable Admin__PasswordHash.
    // "PasswordHash": "",
    // Fallback for secret stores only: the password in clear text (ignored when PasswordHash is set).
    // "Password": "",
    // Sliding lifetime of the login cookie, in hours.
    "SessionHours": 8
  },
  "DataProtection": {
    // Folder for the Data Protection keys (login cookie, antiforgery tokens). Not set: a "keys" folder next to the
    // SQLite database file. Set to an empty string to keep the keys in memory (every restart then signs everybody out).
    // "KeysPath": "data/keys"
  }
}
