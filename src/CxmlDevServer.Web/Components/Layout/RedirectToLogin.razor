@inject NavigationManager Navigation

@code {
    /// <summary>Sends a visitor who may not see the page to the login page, remembering where they wanted to go.</summary>
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(
            $"{AdminAuthExtensions.LoginPath}?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
