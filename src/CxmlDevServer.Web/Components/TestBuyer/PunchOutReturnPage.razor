@using CxmlDevServer.Core.Messaging
@using Cxml.Protocol.Validation
@using CxmlDevServer.Web.Services
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Test buyer: PunchOut return - cXML Dev Server</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/app.css" />
</head>
<body class="plain-page">
<main class="container py-4" style="max-width: 1000px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="text-body-secondary small text-uppercase fw-semibold">Built-in test buyer</div>
            <h1 class="h3 m-0">PunchOut return received</h1>
        </div>
        <a class="btn btn-outline-secondary" href="/">Back to dashboard</a>
    </div>

    @if (Result.Error is not null)
    {
        <div class="alert alert-danger" role="alert" id="return-status">
            <strong>The return could not be processed.</strong> @Result.Error
        </div>
    }
    else if (Result.IsValid)
    {
        <div class="alert alert-success" role="alert" id="return-status">
            <strong>Valid PunchOutOrderMessage.</strong> The document was decoded from <code>@FieldName</code>, matches the cXML DTD and has no rule violations.
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert" id="return-status">
            <strong>The PunchOutOrderMessage has problems.</strong> See the validation issues below.
        </div>
    }

    @if (Result.Summary is { } s)
    {
        <div class="card mb-3">
            <div class="card-header">Summary</div>
            <div class="card-body">
                <dl class="kv">
                    <dt>BuyerCookie</dt><dd><code id="buyer-cookie">@s.BuyerCookie</code></dd>
                    <dt>In reply to</dt><dd><code>@s.InReplyTo</code></dd>
                    <dt>operationAllowed</dt><dd>@s.OperationAllowed.ToCxml()</dd>
                    <dt>Status</dt><dd>@(s.StatusCode?.ToString() ?? "200 (default)")</dd>
                    <dt>Total</dt><dd><strong>@Fmt.Money(s.TotalAmount, s.Currency)</strong> (calculated from the lines: @Fmt.Money(s.CalculatedTotal, s.Currency))</dd>
                    <dt>Items</dt><dd>@s.ItemCount</dd>
                    <dt>Encoding</dt><dd>@FieldName</dd>
                </dl>
            </div>
        </div>
    }

    @if (Result.Message is { Items.Count: > 0 } message)
    {
        <div class="card table-card mb-3">
            <div class="card-header">Items</div>
            <div class="table-responsive-card">
                <table class="table" id="return-items">
                    <thead><tr><th>#</th><th>Part</th><th>Description</th><th class="text-end">Qty</th><th>UoM</th><th class="text-end">Unit price</th><th class="text-end">Line total</th></tr></thead>
                    <tbody>
                    @{ var n = 0; }
                    @foreach (var item in message.Items)
                    {
                        n++;
                        <tr>
                            <td>@(item.LineNumber ?? n)</td>
                            <td><code>@item.ItemId.SupplierPartId</code></td>
                            <td>@(item.ItemDetail.Descriptions.FirstOrDefault()?.Text)</td>
                            <td class="text-end">@Fmt.Quantity(item.Quantity)</td>
                            <td>@item.ItemDetail.UnitOfMeasure</td>
                            <td class="text-end">@Fmt.Money(item.ItemDetail.UnitPrice.Amount, item.ItemDetail.UnitPrice.Currency)</td>
                            <td class="text-end">@Fmt.Money(item.Quantity * item.ItemDetail.UnitPrice.Amount, item.ItemDetail.UnitPrice.Currency)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Result.Issues.Count > 0)
    {
        <div class="card table-card mb-3">
            <div class="card-header">Validation issues (@Result.Issues.Count)</div>
            <div class="table-responsive-card">
                <table class="table">
                    <thead><tr><th>Severity</th><th>Code</th><th>Message</th><th>Line:Pos</th><th>Source</th></tr></thead>
                    <tbody>
                    @foreach (var issue in Result.Issues)
                    {
                        <tr>
                            <td><span class="badge @StatusUi.SeverityClass(issue.Severity)">@issue.Severity</span></td>
                            <td><code>@issue.Code</code></td>
                            <td>@issue.Message</td>
                            <td>@(issue.Line is null ? "-" : $"{issue.Line}:{issue.Position}")</td>
                            <td>@issue.Source</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">Links</div>
        <div class="card-body d-flex flex-wrap gap-3">
            @if (Result.LogId is { } logId)
            {
                <a href="/messages/@logId" id="log-link">Message log entry #@logId</a>
            }
            @if (Result.MatchedSession is { } session)
            {
                <a href="/sessions/@session.Id">PunchOut session #@session.Id</a>
            }
        </div>
    </div>

    @if (Result.Xml is not null)
    {
        <div class="card">
            <div class="card-header">Decoded document</div>
            <div class="card-body"><pre class="xml-view">@XmlFormatter.Pretty(Result.Xml)</pre></div>
        </div>
    }
</main>
</body>
</html>

@code {
    [Parameter, EditorRequired] public PunchOutReturnResult Result { get; set; } = new();

    private string FieldName => Result.Encoding switch
    {
        PunchOutFormEncoding.Base64 => "cXML-base64",
        PunchOutFormEncoding.UrlEncoded => "cXML-urlencoded",
        _ => "(none)",
    };
}
