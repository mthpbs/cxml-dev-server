@page "/catalog"
@using CxmlDevServer.Core.Catalog
@inject UiData Data

<PageHeader Title="Catalog" Subtitle="The products offered in the PunchOut shop.">
    <Actions><a class="btn btn-primary" href="catalog/new"><Icon Name="plus" Size="16" /> New item</a></Actions>
</PageHeader>

<div class="card mb-3">
    <div class="card-body filter-bar">
        <div class="flex-grow-1" style="min-width: 14rem">
            <label class="form-label" for="c-search">Search</label>
            <input id="c-search" class="form-control" placeholder="Name, description, part number, manufacturer" @bind="_text" @bind:event="oninput" @bind:after="FilterChangedAsync" />
        </div>
        <div style="min-width: 12rem">
            <label class="form-label" for="c-category">Category</label>
            <select id="c-category" class="form-select" @bind="_category" @bind:after="FilterChangedAsync">
                <option value="">All categories</option>
                @foreach (var c in _categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <div class="form-check form-switch mb-2">
            <input id="c-inactive" type="checkbox" class="form-check-input" @bind="_includeInactive" @bind:after="FilterChangedAsync" />
            <label class="form-check-label" for="c-inactive">Show inactive</label>
        </div>
    </div>
</div>

<div class="card table-card quickgrid-card">
    <div class="table-responsive-card">
        <QuickGrid @ref="_grid" ItemsProvider="_provider" Pagination="_pagination" Class="table table-hover">
            <TemplateColumn Title="Part no."><code>@context.SupplierPartId</code></TemplateColumn>
            <TemplateColumn Title="Name"><a href="catalog/@context.Id" class="fw-semibold">@context.ShortName</a></TemplateColumn>
            <PropertyColumn Property="i => i.Category" Title="Category" />
            <TemplateColumn Title="Price" Align="Align.Right">@Fmt.Money(context.UnitPrice, context.Currency)</TemplateColumn>
            <PropertyColumn Property="i => i.UnitOfMeasure" Title="UoM" />
            <TemplateColumn Title="Lead time">@(context.LeadTimeDays is { } d ? $"{d} d" : "-")</TemplateColumn>
            <TemplateColumn Title="Status">
                <span class="badge @(context.IsActive ? "text-bg-success" : "text-bg-secondary")">@(context.IsActive ? "active" : "inactive")</span>
            </TemplateColumn>
            <TemplateColumn Title=""><div class="text-end"><a class="btn btn-sm btn-outline-primary" href="catalog/@context.Id">Edit</a></div></TemplateColumn>
        </QuickGrid>
    </div>
    <div class="grid-footer"><Paginator State="_pagination" /></div>
</div>

@code {
    private QuickGrid<CatalogItem>? _grid;
    private readonly PaginationState _pagination = new() { ItemsPerPage = 15 };
    private GridItemsProvider<CatalogItem> _provider = default!;
    private List<string> _categories = [];
    private string _text = string.Empty;
    private string _category = string.Empty;
    private bool _includeInactive;

    protected override async Task OnInitializedAsync()
    {
        _provider = async request =>
        {
            var page = request.StartIndex / Math.Max(1, request.Count ?? 15) + 1;
            var result = await Data.ScopeAsync(sp => sp.GetRequiredService<CatalogQueryService>().SearchAsync(
                new CatalogQuery(_text, string.IsNullOrEmpty(_category) ? null : _category, page, request.Count ?? 15, CatalogSort.Name, _includeInactive),
                request.CancellationToken));
            return GridItemsProviderResult.From(result.Items.ToList(), result.TotalCount);
        };
        _categories = await Data.QueryAsync(async db =>
            await db.CatalogItems.AsNoTracking().Select(i => i.Category).Distinct().OrderBy(c => c).ToListAsync());
    }

    private async Task FilterChangedAsync()
    {
        await _pagination.SetCurrentPageIndexAsync(0);
        if (_grid is not null)
        {
            await _grid.RefreshDataAsync();
        }
    }
}
